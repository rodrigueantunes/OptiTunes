<Application x:Class="OptiTunes.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:OptiTunes.App.Converters"
             StartupUri="Views/MainWindow.xaml"
             ThemeMode="Light">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml" />
                <ResourceDictionary Source="Themes/Logo.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:StatusBrushConverter x:Key="StatusBrush" />
            <conv:RateBrushConverter x:Key="RateBrush" />
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
