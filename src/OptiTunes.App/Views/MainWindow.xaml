<Window x:Class="OptiTunes.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:h="http://helix-toolkit.org/wpf"
        xmlns:vm="clr-namespace:OptiTunes.App.ViewModels"
        xmlns:ctl="clr-namespace:OptiTunes.App.Views.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="{Binding AppVersion, StringFormat=OptiTunes {0} – Optimisation de chargement}"
        Height="900" Width="1500" MinWidth="1200" MinHeight="720"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Icon="pack://application:,,,/OptiTunes;component/Assets/OptiTunes.ico"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver" DragEnter="Window_DragEnter" DragLeave="Window_DragLeave"
        Background="{StaticResource BgBrush}" FontFamily="Segoe UI" FontSize="13"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding ImportCommand}" />
        <KeyBinding Key="F5" Command="{Binding OptimizeCommand}" />
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding ReloadCommand}" />
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding PrintCommand}" />
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding ExportCommand}" />
        <KeyBinding Key="F1" Command="{Binding ShowFormatHelpCommand}" />
        <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding OpenSettingsCommand}" />
        <KeyBinding Key="Escape" Command="{Binding EscapeCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <!-- ===================== Navigation ===================== -->
        <Border Grid.Column="0" Background="{StaticResource PanelDarkBrush}">
            <DockPanel Margin="10,14,10,10">
                <DockPanel DockPanel.Dock="Top" Margin="6,0,0,12">
                    <Image DockPanel.Dock="Left" Source="{StaticResource LogoImage}" Width="46" Height="46" Margin="0,0,10,0" />
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="OptiTunes" Foreground="White" FontSize="22" FontWeight="Bold" />
                            <Button Command="{Binding ShowReleaseNotesCommand}" Cursor="Hand" Margin="6,5,0,0" VerticalAlignment="Top"
                                    ToolTip="Nouveautés de la version" Focusable="False">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="{StaticResource PrimaryBrush}" CornerRadius="8" Padding="6,1">
                                            <TextBlock Text="{Binding AppVersion}" Foreground="White" FontSize="10.5" FontWeight="SemiBold" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#2E86C1" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="Optimisation de chargement" Foreground="#AEB6BF" FontSize="11.5" />
                    </StackPanel>
                </DockPanel>

                <TextBlock DockPanel.Dock="Bottom" Foreground="#95A5A6" FontSize="11" Margin="12,8,0,0"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding SourceName}">
                    <Run Text="Fichier : " /><Run Text="{Binding SourceName, Mode=OneWay}" />
                </TextBlock>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Button Style="{StaticResource NavButton}" Command="{Binding ImportCommand}"
                                ToolTip="Ctrl+O · ou glissez-déposez le fichier sur la fenêtre">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8E5;" Margin="0,2,10,0" />
                                <TextBlock Text="Importer un groupage" />
                            </StackPanel>
                        </Button>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource NavButton}" Command="{Binding ExportTemplateCommand}"
                                    ToolTip="Fichier CSV avec toutes les colonnes, 1 groupage et 2 ordres d'exemple, à remplir ou à transmettre pour l'export ERP">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE9F9;" Margin="0,2,10,0" />
                                    <TextBlock Text="Exporter le modèle CSV" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Style="{StaticResource InfoButton}" Margin="0,0,12,0"
                                    Command="{Binding ShowFormatHelpCommand}" ToolTip="F1 · explication de chaque colonne (obligatoire ou facultative)" />
                        </Grid>
                        <Button Style="{StaticResource NavButton}" Command="{Binding ReloadCommand}"
                                ToolTip="Ctrl+R · relire le fichier (il est aussi relu automatiquement à chaque enregistrement)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE777;" Margin="0,2,10,0" />
                                <TextBlock Text="Recharger le fichier" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButton}" Command="{Binding OptimizeCommand}" ToolTip="F5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72C;" Margin="0,2,10,0" />
                                <TextBlock Text="Recalculer" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButton}" Command="{Binding PrintCommand}"
                                ToolTip="Ctrl+P · feuille de chargement par camion. Choisir « Microsoft Print to PDF » pour un PDF.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE749;" Margin="0,2,10,0" />
                                <TextBlock Text="Imprimer le plan" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButton}" Command="{Binding ExportCommand}" ToolTip="Ctrl+E">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74E;" Margin="0,2,10,0" />
                                <TextBlock Text="Exporter (CSV)" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButton}" Command="{Binding OpenSettingsCommand}"
                                ToolTip="Ctrl+, · liste des véhicules disponibles, véhicule par défaut">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE713;" Margin="0,2,10,0" />
                                <TextBlock Text="Paramètres" />
                            </StackPanel>
                        </Button>

                        <TextBlock Style="{StaticResource NavHeader}" Text="GROUPAGE" />
                        <ComboBox Style="{StaticResource NavComboBox}" ItemsSource="{Binding Groupages}" SelectedItem="{Binding SelectedGroupage}" />

                        <TextBlock Style="{StaticResource NavHeader}" Text="VÉHICULE" />
                        <ComboBox Style="{StaticResource NavComboBox}" ItemsSource="{Binding VehicleChoices}"
                                  SelectedItem="{Binding SelectedVehicleChoice}"
                                  ToolTip="Simuler le groupage sur un autre type de camion" />

                        <TextBlock Style="{StaticResource NavHeader}" Text="RÉPARTITION" />
                        <CheckBox Style="{StaticResource NavCheckBox}" IsChecked="{Binding MultiVehicle}">
                            <TextBlock Text="Ajouter des camions si reliquat" TextWrapping="Wrap" />
                        </CheckBox>
                        <TextBlock Foreground="#ECF0F1" Margin="12,4,0,0" FontSize="12">
                            <Run Text="Nombre maximal de camions :" />
                            <Run Text="{Binding MaxVehicles, Mode=OneWay}" FontWeight="Bold" />
                        </TextBlock>
                        <Slider Minimum="1" Maximum="15" TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="{Binding MaxVehicles, Delay=400}" Margin="12,4" IsEnabled="{Binding MultiVehicle}" />

                        <Expander Style="{StaticResource NavExpander}" Header="DÉBORDS (mm)" IsExpanded="True">
                            <Grid Margin="12,4,8,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="72" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Entre unités" Foreground="#ECF0F1" FontSize="12" VerticalAlignment="Center"
                                           ToolTip="Jeu laissé entre deux palettes / caisses voisines (bout à bout et côte à côte). Pas de jeu entre palettes gerbées." />
                                <TextBox Grid.Column="1" Margin="0,3" TextAlignment="Right" Padding="6,3"
                                         Text="{Binding GapBetweenUnits, UpdateSourceTrigger=PropertyChanged, Delay=600}" />
                                <TextBlock Grid.Row="1" Text="Parois gauche / droite" Foreground="#ECF0F1" FontSize="12" VerticalAlignment="Center"
                                           ToolTip="Espace libre le long de chaque paroi latérale (même valeur à gauche et à droite)." />
                                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,3" TextAlignment="Right" Padding="6,3"
                                         Text="{Binding SideClearance, UpdateSourceTrigger=PropertyChanged, Delay=600}" />
                                <TextBlock Grid.Row="2" Text="Plafond (hauteur)" Foreground="#ECF0F1" FontSize="12" VerticalAlignment="Center"
                                           ToolTip="Espace libre minimal entre le haut des dernières palettes et le plafond." />
                                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,3" TextAlignment="Right" Padding="6,3"
                                         Text="{Binding RoofClearance, UpdateSourceTrigger=PropertyChanged, Delay=600}" />
                                <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="0 = aucun débord" Foreground="#95A5A6" FontSize="11" Margin="0,2,0,0" />
                            </Grid>
                        </Expander>

                        <Expander Style="{StaticResource NavExpander}" Header="RÈGLES DE CALCUL">
                        <StackPanel>
                        <TextBlock Foreground="#ECF0F1" Margin="12,4,0,0" FontSize="12">
                            <Run Text="Taux de support minimal :" />
                            <Run Text="{Binding MinSupportPercent, Mode=OneWay}" FontWeight="Bold" /><Run Text=" %" />
                        </TextBlock>
                        <Slider Minimum="50" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                Value="{Binding MinSupportPercent, Delay=400}" Margin="12,4" />
                        <CheckBox Style="{StaticResource NavCheckBox}" IsChecked="{Binding AllowFloorRotation}"
                                  ToolTip="Décoché : la LONGUEUR du fichier est toujours dans le sens de la longueur du camion">
                            <TextBlock Text="Pivoter les unités au sol (en travers)" TextWrapping="Wrap" />
                        </CheckBox>
                        <CheckBox Style="{StaticResource NavCheckBox}" IsChecked="{Binding StaggerTubes}"
                                  ToolTip="Pas vertical 0,866 × D (§9.3), seulement si plus dense que la grille">
                            <TextBlock Text="Tubes en quinconce si plus dense" TextWrapping="Wrap" />
                        </CheckBox>
                        <CheckBox Style="{StaticResource NavCheckBox}" IsChecked="{Binding RespectDeliveryOrder}">
                            <TextBlock Text="Respecter l'ordre de livraison" TextWrapping="Wrap" />
                        </CheckBox>
                        <CheckBox Style="{StaticResource NavCheckBox}" IsChecked="{Binding MultiStrategy}">
                            <TextBlock Text="Recherche approfondie (toutes les stratégies)" TextWrapping="Wrap" />
                        </CheckBox>
                        <CheckBox Style="{StaticResource NavCheckBox}" IsChecked="{Binding AutoReload}">
                            <TextBlock Text="Recharger quand le fichier est enregistré" TextWrapping="Wrap" />
                        </CheckBox>
                        </StackPanel>
                        </Expander>

                        <Expander Style="{StaticResource NavExpander}" Header="FICHIERS RÉCENTS" IsExpanded="True"
                                  Visibility="{Binding HasRecent, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl ItemsSource="{Binding Recent}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource NavButton}" Padding="12,5" ToolTip="{Binding Path}"
                                                Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE823;" Margin="0,2,10,0" FontSize="11" />
                                                <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="180" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>

                        <Expander Style="{StaticResource NavExpander}" Header="EXEMPLES">
                        <ItemsControl ItemsSource="{Binding Samples}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource NavButton}" Padding="12,5"
                                            Command="{Binding DataContext.OpenSampleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE9F9;" Margin="0,2,10,0" FontSize="11" />
                                            <TextBlock Text="{Binding Name}" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===================== Contenu central ===================== -->
        <Grid Grid.Column="1" Margin="4,4,0,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- En-tête -->
            <Border Style="{StaticResource CardStyle}" Padding="18,10" Margin="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding GroupageText}" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding VehicleText}" Style="{StaticResource Muted}" FontSize="12.5" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding ItineraryText}" FontSize="12" Margin="0,2,0,0" Foreground="#1F618D" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding ItineraryText}" Visibility="{Binding HasItinerary, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding ClearanceText}" FontSize="12" Margin="0,2,0,0" Foreground="#B9770E"
                                   Visibility="{Binding HasClearances, Converter={StaticResource BoolToVisibility}}" />
                        <Border Style="{StaticResource Pill}" Padding="12,5" CornerRadius="16" Background="#FEF5E7" BorderBrush="{StaticResource WarningBrush}"
                                BorderThickness="1" Margin="0,8,0,0" Visibility="{Binding HasExclusions, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE945;" Foreground="{StaticResource WarningBrush}" Margin="0,2,8,0" />
                                <TextBlock Text="{Binding ExclusionText}" Foreground="#9C640C" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Style="{StaticResource GhostButton}" Command="{Binding IncludeAllCommand}" Margin="8,0,0,0" Padding="6,0"
                                        Content="Tout réintégrer" Foreground="#2E86C1" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource Pill}" Padding="14,7" CornerRadius="16"
                            Background="{Binding ValidationStatus, Converter={StaticResource StatusBrush}}"
                            Visibility="{Binding HasPlan, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="Contrôle indépendant de toutes les contraintes (onglet Contrôles)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE73E;" Foreground="White" Margin="0,2,8,0" />
                            <TextBlock Text="{Binding ValidationText}" Foreground="White" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Tuiles d'indicateurs globaux -->
            <UniformGrid Grid.Row="1" Columns="4" Margin="0,-4,0,0">
                <Border Style="{StaticResource KpiTile}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#E8F4FC" CornerRadius="6" Width="24" Height="24" Margin="0,0,8,0">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE806;" Foreground="{StaticResource PrimaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" />
                            </Border>
                            <TextBlock Style="{StaticResource KpiLabel}" Text="CAMIONS" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource KpiValue}" Text="{Binding VehiclesKpi}" />
                        <TextBlock Style="{StaticResource Muted}" Text="{Binding VehiclesKpiDetail}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiTile}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#E8F4FC" CornerRadius="6" Width="24" Height="24" Margin="0,0,8,0">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7B8;" Foreground="{StaticResource PrimaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" />
                            </Border>
                            <TextBlock Style="{StaticResource KpiLabel}" Text="ARTICLES CHARGÉS" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource KpiValue}" Text="{Binding ItemsKpi}" />
                        <TextBlock Style="{StaticResource Muted}" Text="{Binding ItemsKpiDetail}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiTile}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#E8F4FC" CornerRadius="6" Width="24" Height="24" Margin="0,0,8,0">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE945;" Foreground="{StaticResource PrimaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" />
                            </Border>
                            <TextBlock Style="{StaticResource KpiLabel}" Text="POIDS TOTAL" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource KpiValue}" Text="{Binding WeightKpi}" />
                        <TextBlock Style="{StaticResource Muted}" Text="{Binding Metrics.WeightRate, StringFormat={}{0:0} % de la charge utile}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiTile}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#E8F4FC" CornerRadius="6" Width="24" Height="24" Margin="0,0,8,0">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7C2;" Foreground="{StaticResource PrimaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" />
                            </Border>
                            <TextBlock Style="{StaticResource KpiLabel}" Text="MÉTRAGE LINÉAIRE RÉEL" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource KpiValue}" Text="{Binding MlKpi}" />
                        <TextBlock Style="{StaticResource Muted}" Text="{Binding MlKpiDetail}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Barre : solution, camion, recherche, couleurs -->
            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="14,8" Margin="6,2,6,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Rangement" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding StowageChoices}" SelectedItem="{Binding SelectedStowage}" Width="170" Padding="8,4"
                                  Margin="0,0,16,0" ToolTip="{Binding SelectedStowage.Description}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2" MaxWidth="360">
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                        <TextBlock x:Name="Desc" Text="{Binding Description}" Style="{StaticResource Muted}" TextWrapping="Wrap" Width="340" />
                                    </StackPanel>
                                    <!-- Champ fermé : libellé seul ; la description n'apparaît que dans la liste déroulante -->
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" Value="{x:Null}">
                                            <Setter TargetName="Desc" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="Solution" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding Solutions}" SelectedItem="{Binding SelectedSolution}" Width="300" Padding="8,4"
                                  ToolTip="La recommandée prend la meilleure stratégie pour chaque camion ; les autres appliquent une stratégie unique.">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Margin="0,0,6,0"
                                                     Fill="{Binding IsValid, Converter={StaticResource StatusBrush}}" />
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" Margin="14,0,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="Camion" FontWeight="SemiBold" VerticalAlignment="Center" Margin="18,0,8,0" />
                    </StackPanel>
                    <ListBox Grid.Column="1" Style="{StaticResource PillListBox}" ItemsSource="{Binding Loads}"
                             SelectedItem="{Binding SelectedLoad}" VerticalAlignment="Center">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" ToolTip="{Binding Details}">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE806;" Margin="0,2,6,0" />
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Summary}" Margin="8,0,0,0" Opacity="0.75" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <TabControl Grid.Row="3" Margin="8,0,8,4">
                <!-- Vue 3D -->
                <TabItem Header="Vue 3D">
                    <Border Style="{StaticResource CardStyle}" Margin="0" Padding="0">
                        <Grid ClipToBounds="True">
                            <h:HelixViewport3D x:Name="Viewport" Background="#F7F9F9" ShowViewCube="True"
                                               ShowCoordinateSystem="False" ZoomExtentsWhenLoaded="True"
                                               IsHeadLightEnabled="True" ModelUpDirection="0,0,1"
                                               MouseLeftButtonDown="Viewport_MouseLeftButtonDown"
                                               MouseMove="Viewport_MouseMove" MouseLeave="Viewport_MouseLeave"
                                               ShowFrameRate="False" InfiniteSpin="False">
                                <h:DefaultLights />
                                <ModelVisual3D Content="{Binding Scene3D}" />
                            </h:HelixViewport3D>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="12">
                                <Button Style="{StaticResource LightButton}" Content="3/4" Click="CameraIso_Click" />
                                <Button Style="{StaticResource LightButton}" Content="Dessus" Click="CameraTop_Click" />
                                <Button Style="{StaticResource LightButton}" Content="Côté" Click="CameraSide_Click" />
                                <Button Style="{StaticResource LightButton}" Content="Arrière (porte)" Click="CameraRear_Click" />
                                <Button Style="{StaticResource LightButton}" Content="Ajuster" Click="ZoomExtents_Click" />
                            </StackPanel>

                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,110,0"
                                       Style="{StaticResource Muted}"
                                       Text="Clic : sélection · clic droit : rotation · molette : zoom · survol : informations" />

                            <!-- Infobulle de survol -->
                            <Canvas IsHitTestVisible="False">
                                <Border x:Name="HoverCard" Visibility="Collapsed" Background="#F5FFFFFF" CornerRadius="8"
                                        BorderBrush="{StaticResource PanelDarkBrush}" BorderThickness="1" Padding="10,8" MaxWidth="380">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.25" />
                                    </Border.Effect>
                                    <TextBlock Text="{Binding HoverText}" TextWrapping="Wrap" LineHeight="18" FontSize="12.5" />
                                </Border>
                            </Canvas>

                            <Border VerticalAlignment="Bottom" Margin="12" Padding="12,8" CornerRadius="10" Background="#E6FFFFFF">
                                <DockPanel>
                                    <Button DockPanel.Dock="Left" Style="{StaticResource RoundedButton}" Margin="0,0,12,0"
                                            Padding="12,5" Command="{Binding ToggleAnimationCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE768;" Margin="0,2,6,0" />
                                            <TextBlock Text="Rejouer le chargement" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="90">
                                        <Run Text="Étape " /><Run Text="{Binding StepText, Mode=OneWay}" FontWeight="SemiBold" />
                                    </TextBlock>
                                    <Slider Minimum="0" Maximum="{Binding MaxVisible}" Value="{Binding VisibleCount}"
                                            IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Border>
                </TabItem>

                <!-- Vue 2D -->
                <TabItem Header="Vue 2D">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,6,6">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardTitle}" Text="Vue de dessus (plancher)" />
                                <ctl:PlanView2D Options="{Binding Plan.Options}" Mode="Top" Load="{Binding CurrentLoad}" Colors="{Binding OrderColors}"
                                                HighlightOrderIds="{Binding HighlightOrderIds}"
                                                VisibleCount="{Binding VisibleCount}" SelectedUnitId="{Binding SelectedUnitId}" />
                            </DockPanel>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,6,6">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardTitle}" Text="Vue de côté" />
                                <ctl:PlanView2D Options="{Binding Plan.Options}" Mode="Side" Load="{Binding CurrentLoad}" Colors="{Binding OrderColors}"
                                                HighlightOrderIds="{Binding HighlightOrderIds}"
                                                VisibleCount="{Binding VisibleCount}" SelectedUnitId="{Binding SelectedUnitId}" />
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="1" Grid.RowSpan="2" Style="{StaticResource CardStyle}" Margin="0,0,0,6">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardTitle}" Text="Vue arrière (depuis la porte)" />
                                <ctl:PlanView2D Options="{Binding Plan.Options}" Mode="Rear" Load="{Binding CurrentLoad}" Colors="{Binding OrderColors}"
                                                HighlightOrderIds="{Binding HighlightOrderIds}"
                                                VisibleCount="{Binding VisibleCount}" SelectedUnitId="{Binding SelectedUnitId}" />
                            </DockPanel>
                        </Border>
                        <Border Grid.Row="2" Grid.ColumnSpan="2" Padding="12,8" CornerRadius="10" Background="White">
                            <DockPanel>
                                <Button DockPanel.Dock="Left" Style="{StaticResource RoundedButton}" Margin="0,0,12,0"
                                        Padding="12,5" Command="{Binding ToggleAnimationCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE768;" Margin="0,2,6,0" />
                                        <TextBlock Text="Rejouer le chargement" />
                                    </StackPanel>
                                </Button>
                                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="90">
                                    <Run Text="Étape " /><Run Text="{Binding StepText, Mode=OneWay}" FontWeight="SemiBold" />
                                </TextBlock>
                                <Slider Minimum="0" Maximum="{Binding MaxVisible}" Value="{Binding VisibleCount}"
                                        IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Comparaison des solutions -->
                <TabItem Header="Solutions">
                    <Border Style="{StaticResource CardStyle}" Margin="0" Padding="16,12">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock Text="Comparer les solutions" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                                           Text="Classées du meilleur au moins bon : reliquat, nombre de camions, métrage réel, ordres scindés. Cliquez une ligne pour afficher la solution." />
                            </StackPanel>
                            <Border BorderBrush="#E3E8EC" BorderThickness="1" CornerRadius="10" Padding="1">
                                <DataGrid ItemsSource="{Binding Solutions}" SelectedItem="{Binding SelectedSolution}" RowHeight="38">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="" Width="36" CanUserResize="False">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Ellipse Width="10" Height="10" Fill="{Binding StatusLevel, Converter={StaticResource StatusBrush}}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Solution" Binding="{Binding Title}" FontWeight="SemiBold" MinWidth="260" />
                                        <DataGridTextColumn Header="Camions" Binding="{Binding Trucks}" />
                                        <DataGridTextColumn Header="Articles chargés" Binding="{Binding Items}" />
                                        <DataGridTextColumn Header="Reliquat" Binding="{Binding Remaining, StringFormat=N0}" />
                                        <DataGridTextColumn Header="ML réel total (m)" Binding="{Binding MlReal, StringFormat=N2}" />
                                        <DataGridTextColumn Header="ML camion le plus chargé (m)" Binding="{Binding MaxLoadMl, StringFormat=N2}" />
                                        <DataGridTextColumn Header="Poids (%)" Binding="{Binding WeightRate, StringFormat=N0}" />
                                        <DataGridTextColumn Header="Ordres scindés" Binding="{Binding SplitOrders}" />
                                        <DataGridTextColumn Header="Ordres incomplets" Binding="{Binding IncompleteOrders}" />
                                        <DataGridTextColumn Header="Contrôle" Binding="{Binding Conformity}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </DockPanel>
                    </Border>
                </TabItem>

                <!-- Ordres -->
                <TabItem Header="Ordres de transport">
                    <Border Style="{StaticResource CardStyle}" Margin="0" Padding="0">
                        <DataGrid ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}" RowHeight="34">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Charger" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsIncluded, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                                                      ToolTip="Décocher pour simuler le groupage sans cet ordre" MinWidth="0" Margin="4,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="32" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding Brush}" Width="7" Height="18" CornerRadius="3" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Ordre" Binding="{Binding Id}" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="Type" Binding="{Binding Kind}" />
                                <DataGridTextColumn Header="Commande" Binding="{Binding Reference}" />
                                <DataGridTextColumn Header="Client" Binding="{Binding Customer}" />
                                <DataGridTextColumn Header="Magasin" Binding="{Binding Warehouse}" />
                                <DataGridTextColumn Header="Départ" Binding="{Binding Departure}" />
                                <DataGridTextColumn Header="Arrivée" Binding="{Binding Arrival}" />
                                <DataGridTextColumn Header="Arrêt" Binding="{Binding Stop}" />
                                <DataGridTextColumn Header="Article" Binding="{Binding Article}" />
                                <DataGridTextColumn Header="Famille" Binding="{Binding Type}" />
                                <DataGridTextColumn Header="Qté" Binding="{Binding Quantity, StringFormat=N0}" />
                                <DataGridTextColumn Header="Dimensions (mm)" Binding="{Binding Dimensions}" />
                                <DataGridTextColumn Header="Poids total (kg)" Binding="{Binding TotalWeight, StringFormat=N1}" />
                                <DataGridTextColumn Header="Gerbable" Binding="{Binding Stacking}" />
                                <DataGridTemplateColumn Header="ML plancher (m)">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding MlRows, StringFormat=N2}" FontWeight="SemiBold" ToolTip="{Binding MlTooltip}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="ML équiv. (m)" Binding="{Binding MlEquivalent, StringFormat=N2}" />
                                <DataGridTextColumn Header="Camion(s)" Binding="{Binding Vehicles}" />
                                <DataGridTextColumn Header="Chargé" Binding="{Binding Loaded}" />
                                <DataGridTextColumn Header="Reliquat" Binding="{Binding Remaining}" />
                                <DataGridTemplateColumn Header="Statut" MinWidth="240">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="10" Height="10" Margin="0,0,6,0"
                                                         Fill="{Binding StatusLevel, Converter={StaticResource StatusBrush}}" />
                                                <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </TabItem>

                <!-- Plan de chargement du camion -->
                <TabItem Header="Plan de chargement">
                    <Border Style="{StaticResource CardStyle}" Margin="0" Padding="0">
                        <DataGrid ItemsSource="{Binding Units}" SelectedItem="{Binding SelectedUnit}" RowHeight="28">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="32" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding Brush}" Width="7" Height="18" CornerRadius="3" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="N°" Binding="{Binding Sequence}" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="Unité" Binding="{Binding UnitId}" />
                                <DataGridTextColumn Header="Article" Binding="{Binding Article}" />
                                <DataGridTextColumn Header="Client" Binding="{Binding Customer}" />
                                <DataGridTextColumn Header="Famille" Binding="{Binding Type}" />
                                <DataGridTextColumn Header="Nb art." Binding="{Binding Items, StringFormat=N0}" />
                                <DataGridTextColumn Header="X (mm)" Binding="{Binding X, StringFormat=N0}" />
                                <DataGridTextColumn Header="Y (mm)" Binding="{Binding Y, StringFormat=N0}" />
                                <DataGridTextColumn Header="Z (mm)" Binding="{Binding Z, StringFormat=N0}" />
                                <DataGridTextColumn Header="Encombrement (mm)" Binding="{Binding Size}" />
                                <DataGridTextColumn Header="Niveau (0 = sol)" Binding="{Binding Level}" />
                                <DataGridTextColumn Header="Poids (kg)" Binding="{Binding Weight, StringFormat=N1}" />
                                <DataGridTextColumn Header="Charge dessus / max (kg)" Binding="{Binding Load}" />
                                <DataGridTextColumn Header="Posé sur" Binding="{Binding Supports}" />
                                <DataGridTextColumn Header="Étapes" Binding="{Binding Stop}" />
                                <DataGridTextColumn Header="Zone" Binding="{Binding Zone}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </TabItem>

                <!-- Contrôles -->
                <TabItem Header="Contrôles">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="340" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,6,6">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardTitle}"
                                           Text="Validation indépendante de la solution affichée (tous camions)" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Checks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="22" />
                                                            <ColumnDefinition Width="240" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse Width="12" Height="12" VerticalAlignment="Top" Margin="0,3,0,0"
                                                                 Fill="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" />
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="{Binding Rule}" Style="{StaticResource Muted}" />
                                                            <ItemsControl ItemsSource="{Binding Violations}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding StringFormat=• {0}}" TextWrapping="Wrap" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="3" Text="{Binding Summary}" Style="{StaticResource Muted}" Margin="12,0,0,0" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,0,6">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardTitle}" Text="Stratégies évaluées (camion affiché)" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Strategies}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,2">
                                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}">
                                                        <Run Text="{Binding Units, Mode=OneWay}" /><Run Text=" u · " /><Run Text="{Binding LengthUsedM, StringFormat=N1, Mode=OneWay}" /><Run Text=" m" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource CardStyle}" Margin="0" Padding="0">
                            <DataGrid ItemsSource="{Binding Issues}">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="36" CanUserResize="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Ellipse Width="10" Height="10" Fill="{Binding Severity, Converter={StaticResource StatusBrush}}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Origine" Binding="{Binding Source}" />
                                    <DataGridTextColumn Header="Niveau" Binding="{Binding Label}" />
                                    <DataGridTextColumn Header="Ligne" Binding="{Binding Line}" />
                                    <DataGridTextColumn Header="Message" Binding="{Binding Message}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Rapport d'import -->
                <TabItem Header="Import">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="420" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.ColumnSpan="2" Style="{StaticResource CardStyle}" Margin="0,0,0,6">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Style="{StaticResource Pill}" Background="{StaticResource DangerBrush}" Margin="0,0,6,0">
                                        <TextBlock Foreground="White" FontWeight="SemiBold"><Run Text="{Binding ImportErrors, Mode=OneWay}" /><Run Text=" bloquant(s)" /></TextBlock>
                                    </Border>
                                    <Border Style="{StaticResource Pill}" Background="{StaticResource WarningBrush}" Margin="0,0,6,0">
                                        <TextBlock Foreground="White" FontWeight="SemiBold"><Run Text="{Binding ImportWarnings, Mode=OneWay}" /><Run Text=" avertissement(s)" /></TextBlock>
                                    </Border>
                                    <Border Style="{StaticResource Pill}" Background="{StaticResource PrimaryBrush}" Margin="0,0,12,0">
                                        <TextBlock Foreground="White" FontWeight="SemiBold"><Run Text="{Binding ImportInfos, Mode=OneWay}" /><Run Text=" info(s)" /></TextBlock>
                                    </Border>
                                    <Button Style="{StaticResource RoundedButton}" Command="{Binding ReloadCommand}" Padding="12,5" Margin="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE777;" Margin="0,2,6,0" />
                                            <TextBlock Text="Recharger" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{Binding ImportSummary}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource Muted}" FontSize="12">
                                        <Run Text="{Binding ImportCounts, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding ImportTimeText, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,6,6" Padding="0">
                            <DataGrid ItemsSource="{Binding ImportIssues}" SelectedItem="{Binding SelectedImportIssue}">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="36" CanUserResize="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Ellipse Width="10" Height="10" Fill="{Binding Severity, Converter={StaticResource StatusBrush}}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Niveau" Binding="{Binding Label}" />
                                    <DataGridTextColumn Header="Ligne" Binding="{Binding Line}" />
                                    <DataGridTextColumn Header="Message" Binding="{Binding Message}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,0,6">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardTitle}" Text="Colonnes reconnues" />
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Text="Correspondance entre l'en-tête du fichier et les champs OptiTunes. Une colonne non reconnue est ignorée." />
                                <DataGrid ItemsSource="{Binding ImportColumns}" RowHeight="24">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Ligne" Binding="{Binding Record}" />
                                        <DataGridTextColumn Header="N°" Binding="{Binding Position}" />
                                        <DataGridTextColumn Header="Colonne du fichier" Binding="{Binding FileColumn}" />
                                        <DataGridTemplateColumn Header="Champ OptiTunes">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock x:Name="F" Text="{Binding Field}" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" />
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Field}" Value="{x:Null}">
                                                            <Setter TargetName="F" Property="Text" Value="ignorée" />
                                                            <Setter TargetName="F" Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="2" Grid.ColumnSpan="2" CornerRadius="10" Background="#2C3E50" Padding="14,10">
                            <TextBlock Text="{Binding SelectedRawLine}" Foreground="#ECF0F1" FontFamily="Consolas" FontSize="12.5"
                                       TextWrapping="Wrap" />
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Auto-test -->
                <TabItem Header="Auto-test">
                    <Border Style="{StaticResource CardStyle}" Margin="0">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <Button DockPanel.Dock="Left" Style="{StaticResource SuccessButton}" Command="{Binding RunSelfTestCommand}"
                                        Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE9D9;" Margin="0,2,8,0" />
                                        <TextBlock Text="Lancer le banc d'essai" />
                                    </StackPanel>
                                </Button>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelfTestSummary}" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Muted}"
                                               Text="Cas vérifiables à la main (§20 / §24 de l'analyse, multi-camions) + 100 groupages aléatoires contrôlés par le validateur." />
                                </StackPanel>
                            </DockPanel>
                            <DataGrid ItemsSource="{Binding SelfTests}">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="36" CanUserResize="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Ellipse Width="10" Height="10" Fill="{Binding Passed, Converter={StaticResource StatusBrush}}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Cas" Binding="{Binding Name}" />
                                    <DataGridTextColumn Header="Attendu" Binding="{Binding Expected}" />
                                    <DataGridTextColumn Header="Obtenu" Binding="{Binding Obtained}" />
                                    <DataGridTextColumn Header="ms" Binding="{Binding Duration.TotalMilliseconds, StringFormat=N0}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </TabItem>
                <!-- Détail du calcul -->
                <TabItem Header="Détail du calcul">
                    <Grid>
                        <Grid.Resources>
                            <!-- Bloc repliable du détail : en-tête cliquable avec chevron, ouvert par défaut -->
                            <Style x:Key="DetailExpander" TargetType="Expander">
                                <Setter Property="Margin" Value="0,4,0,2" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Expander">
                                            <StackPanel>
                                                <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                              Cursor="Hand" Focusable="False" HorizontalContentAlignment="Stretch"
                                                              ToolTip="Cliquer pour replier ou déplier le bloc">
                                                    <ToggleButton.Template>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <Border x:Name="Bd" Background="#F3F6F9" BorderBrush="#E3E8EC" BorderThickness="1" CornerRadius="8" Padding="10,7">
                                                                <DockPanel>
                                                                    <TextBlock x:Name="Chevron" DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" Text="&#xE70D;"
                                                                               FontSize="11" Margin="0,3,10,0" Foreground="{StaticResource PrimaryBrush}" />
                                                                    <TextBlock x:Name="Hint" DockPanel.Dock="Right" Text="replier" FontSize="11" Margin="12,2,0,0"
                                                                               Foreground="{StaticResource MutedBrush}" />
                                                                    <ContentPresenter />
                                                                </DockPanel>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="False">
                                                                    <Setter TargetName="Chevron" Property="Text" Value="&#xE76C;" />
                                                                    <Setter TargetName="Hint" Property="Text" Value="déplier" />
                                                                    <Setter TargetName="Bd" Property="Background" Value="White" />
                                                                </Trigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="#E6EEF5" />
                                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </ToggleButton.Template>
                                                    <TextBlock Text="{TemplateBinding Header}" FontWeight="Bold" FontSize="13.5" TextWrapping="Wrap"
                                                               Foreground="{StaticResource TextBrush}" />
                                                </ToggleButton>
                                                <ContentPresenter x:Name="Body" Visibility="Collapsed" Margin="8,4,0,4" />
                                            </StackPanel>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsExpanded" Value="True">
                                                    <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <!-- Une ligne d'explication : phrase, calcul chiffré, résultat, précision, attention, anomalie -->
                            <DataTemplate x:Key="DetailLineTemplate">
                                <Border x:Name="Box" Padding="0,3" Margin="0,1" CornerRadius="6" HorizontalAlignment="Left">
                                    <DockPanel>
                                        <TextBlock x:Name="Glyph" DockPanel.Dock="Left" Text="•" Width="22" TextAlignment="Center"
                                                   Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,0,4,0" />
                                        <TextBlock x:Name="Body" Text="{Binding Text}" TextWrapping="Wrap" FontSize="13" MaxWidth="1100"
                                                   Foreground="{StaticResource TextBrush}" />
                                    </DockPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="Formula">
                                        <Setter TargetName="Box" Property="Background" Value="#EEF5FB" />
                                        <Setter TargetName="Box" Property="Padding" Value="0,5,12,5" />
                                        <Setter TargetName="Box" Property="Margin" Value="22,2,0,2" />
                                        <Setter TargetName="Glyph" Property="Text" Value="=" />
                                        <Setter TargetName="Glyph" Property="FontWeight" Value="Bold" />
                                        <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                        <Setter TargetName="Body" Property="Foreground" Value="#1B4F72" />
                                        <Setter TargetName="Body" Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Heading">
                                        <Setter TargetName="Box" Property="Margin" Value="0,10,0,2" />
                                        <Setter TargetName="Glyph" Property="Text" Value="▸" />
                                        <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                        <Setter TargetName="Body" Property="FontWeight" Value="Bold" />
                                        <Setter TargetName="Body" Property="FontSize" Value="14" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Result">
                                        <Setter TargetName="Glyph" Property="Text" Value="✔" />
                                        <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                        <Setter TargetName="Body" Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Note">
                                        <Setter TargetName="Glyph" Property="Text" Value="ⓘ" />
                                        <Setter TargetName="Body" Property="Foreground" Value="{StaticResource MutedBrush}" />
                                        <Setter TargetName="Body" Property="FontStyle" Value="Italic" />
                                        <Setter TargetName="Body" Property="FontSize" Value="12" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Warning">
                                        <Setter TargetName="Box" Property="Background" Value="#FEF5E7" />
                                        <Setter TargetName="Box" Property="Padding" Value="0,5,12,5" />
                                        <Setter TargetName="Glyph" Property="Text" Value="⚠" />
                                        <Setter TargetName="Glyph" Property="Foreground" Value="#B9770E" />
                                        <Setter TargetName="Body" Property="Foreground" Value="#7E5109" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Error">
                                        <Setter TargetName="Box" Property="Background" Value="#FDEDEC" />
                                        <Setter TargetName="Box" Property="Padding" Value="0,5,12,5" />
                                        <Setter TargetName="Glyph" Property="Text" Value="✖" />
                                        <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource DangerBrush}" />
                                        <Setter TargetName="Body" Property="Foreground" Value="#922B21" />
                                        <Setter TargetName="Body" Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </Grid.Resources>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Sommaire -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0" Padding="10,12">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="6,0,6,10">
                                    <TextBlock Text="Sommaire" FontWeight="Bold" FontSize="15" />
                                    <TextBlock Style="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap"
                                               Text="Cliquez sur une étape pour y aller. Le détail suit la solution affichée." />
                                </StackPanel>
                                <Button DockPanel.Dock="Bottom" Style="{StaticResource OutlineButton}" Command="{Binding CopyCalculationCommand}"
                                        Margin="4,10,4,0" Padding="10,7" ToolTip="Copie tout le détail en texte (courriel, document)">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8C8;" Margin="0,2,8,0" />
                                        <TextBlock Text="Copier le détail" />
                                    </StackPanel>
                                </Button>
                                <ListBox x:Name="CalculationToc" ItemsSource="{Binding CalculationView}" SelectedItem="{Binding SelectedCalculationSection}"
                                         BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         SelectionChanged="CalculationToc_SelectionChanged">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="Bd" CornerRadius="7" Padding="8,6" Margin="0,1" Background="Transparent">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#EEF2F5" />
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#E3F0FA" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <Border x:Name="Num" DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="11" Margin="0,0,8,0"
                                                        Background="{StaticResource PanelDarkBrush}" VerticalAlignment="Top">
                                                    <TextBlock x:Name="NumText" Text="{Binding Number}" Foreground="White" FontSize="11" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="12.5" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Number}" Value="0">
                                                    <Setter TargetName="Num" Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                    <Setter TargetName="NumText" Property="Text" Value="★" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <!-- Étapes -->
                        <ScrollViewer x:Name="CalculationScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="CalculationItems" ItemsSource="{Binding CalculationView}" Margin="0,0,8,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12" Padding="20,16">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,4">
                                                    <Border x:Name="Num" DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="15" Margin="0,0,12,0"
                                                            Background="{StaticResource PanelDarkBrush}">
                                                        <TextBlock x:Name="NumText" Text="{Binding Number}" Foreground="White" FontSize="14" FontWeight="Bold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextBrush}" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding Purpose}" Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap"
                                                           Margin="42,0,0,10" />
                                                <ItemsControl ItemsSource="{Binding Intro}" ItemTemplate="{StaticResource DetailLineTemplate}" Margin="14,0,0,0" />
                                                <!-- Un bloc par ordre (et les totaux) : cliquer sur l'en-tête replie ou ouvre -->
                                                <ItemsControl ItemsSource="{Binding Blocks}" Margin="14,4,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Expander Style="{StaticResource DetailExpander}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                                                      Header="{Binding Title}">
                                                                <ItemsControl ItemsSource="{Binding Lines}" ItemTemplate="{StaticResource DetailLineTemplate}" />
                                                            </Expander>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <ctl:DetailTableView Table="{Binding Table}" Margin="36,12,0,2"
                                                                     Visibility="{Binding HasTable, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Number}" Value="0">
                                                <Setter TargetName="Num" Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                <Setter TargetName="NumText" Property="Text" Value="★" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock Grid.ColumnSpan="2" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"
                                   Text="Importez un groupage : le détail du calcul de la solution affichée apparaîtra ici."
                                   Visibility="{Binding HasCalculation, Converter={StaticResource InverseBoolToVisibility}}" />
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- Barre d'état -->
            <DockPanel Grid.Row="4" Margin="14,0,10,2">
                <ProgressBar DockPanel.Dock="Right" Width="140" Height="6" IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" />
            </DockPanel>

            <!-- Accueil (aucun fichier) -->
            <Border Grid.Row="0" Grid.RowSpan="5" Background="{StaticResource BgBrush}"
                    Visibility="{Binding HasFile, Converter={StaticResource InverseBoolToVisibility}}">
                <Border Style="{StaticResource CardStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="40,32" MaxWidth="640">
                    <StackPanel>
                        <Image Source="{StaticResource LogoImage}" Width="96" Height="96" HorizontalAlignment="Center" />
                        <TextBlock Text="Bienvenue dans OptiTunes" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,16,0,4"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="Optimisation du chargement de vos groupages : plan 3D / 2D, métrage linéaire, répartition multi-camions."
                                   Style="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" />
                        <Border BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="2" CornerRadius="12" Margin="0,22,0,0" Padding="20,18"
                                Background="#F4FAFE">
                            <StackPanel>
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE896;" FontSize="30" HorizontalAlignment="Center"
                                           Foreground="{StaticResource PrimaryBrush}" />
                                <TextBlock Text="Glissez-déposez ici l'export du groupage (.csv / .txt)" FontWeight="SemiBold" FontSize="14"
                                           HorizontalAlignment="Center" Margin="0,8,0,10" />
                                <Button Style="{StaticResource RoundedButton}" Command="{Binding ImportCommand}" HorizontalAlignment="Center" Padding="18,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8E5;" Margin="0,2,8,0" />
                                        <TextBlock Text="Choisir un fichier" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Fichiers récents" FontWeight="SemiBold" Margin="0,20,0,6"
                                   Visibility="{Binding HasRecent, Converter={StaticResource BoolToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding Recent}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource LegendButton}"
                                            Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" Text="&#xE8A5;" Margin="0,2,10,0"
                                                       Foreground="{StaticResource PrimaryBrush}" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Folder}" Style="{StaticResource Muted}" MaxWidth="280"
                                                       TextTrimming="CharacterEllipsis" Margin="12,0,0,0" />
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,18,0,0" TextWrapping="Wrap"
                                   Text="Pas de fichier sous la main ? Ouvrez un exemple dans la colonne de gauche (section EXEMPLES)." />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                            <Button Style="{StaticResource LightButton}" Command="{Binding ExportTemplateCommand}" Padding="14,6" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE9F9;" Margin="0,2,8,0" />
                                    <TextBlock Text="Exporter le modèle CSV" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource LightButton}" Command="{Binding ShowFormatHelpCommand}" Padding="14,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE946;" Margin="0,2,8,0" />
                                    <TextBlock Text="Description des colonnes" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>

            <!-- Paramètres -->
            <Border Grid.Row="0" Grid.RowSpan="5" Background="{StaticResource BgBrush}"
                    Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource CardStyle}" Margin="6" Padding="22,18" DataContext="{Binding Settings}">
                    <DockPanel>
                        <!-- En-tête -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource OutlineButton}" Margin="0,0,8,0"
                                        Command="{Binding DataContext.CloseSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72B;" Margin="0,2,6,0" />
                                        <TextBlock Text="Retour" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SuccessButton}" Command="{Binding SaveCommand}" Margin="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74E;" Margin="0,2,6,0" />
                                        <TextBlock Text="Enregistrer" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <Border Background="#E8F4FC" CornerRadius="10" Width="42" Height="42" Margin="0,0,12,0">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE713;" FontSize="20" Foreground="{StaticResource PrimaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Paramètres" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Style="{StaticResource Muted}" FontSize="12"
                                           Text="Les modifications s'appliquent après « Enregistrer ». Dimensions intérieures utiles en mm, charge utile en kg." />
                            </StackPanel>
                        </DockPanel>

                        <!-- Véhicule par défaut + message -->
                        <Border DockPanel.Dock="Bottom" Background="#F7F9FA" CornerRadius="10" Padding="14,10" Margin="0,12,0,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Message}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"
                                           VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="420" />
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="Véhicule par défaut" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Muted}" Text="Appliqué quand le fichier ne définit pas de véhicule." />
                                    </StackPanel>
                                    <ComboBox ItemsSource="{Binding DefaultChoices}" SelectedItem="{Binding DefaultVehicle}" Width="260"
                                              VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Liste des véhicules -->
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" Style="{StaticResource OutlineButton}" Command="{Binding ResetDefaultsCommand}" Margin="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE777;" Margin="0,2,6,0" />
                                        <TextBlock Text="Rétablir la liste par défaut" />
                                    </StackPanel>
                                </Button>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Véhicules disponibles" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" />
                                    <Button Style="{StaticResource RoundedButton}" Command="{Binding AddCommand}" Margin="0,0,6,0" Padding="12,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE710;" Margin="0,2,6,0" />
                                            <TextBlock Text="Ajouter" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource OutlineButton}" Command="{Binding DuplicateCommand}" Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8C8;" Margin="0,2,6,0" />
                                            <TextBlock Text="Dupliquer" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource OutlineButton}" Command="{Binding RemoveCommand}" Margin="0,0,6,0" Foreground="{StaticResource DangerBrush}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74D;" Margin="0,2,6,0" />
                                            <TextBlock Text="Supprimer" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource OutlineButton}" Command="{Binding MoveUpCommand}" Margin="0,0,4,0" ToolTip="Monter">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE70E;" />
                                    </Button>
                                    <Button Style="{StaticResource OutlineButton}" Command="{Binding MoveDownCommand}" Margin="0" ToolTip="Descendre">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE70D;" />
                                    </Button>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="0,0,0,8"
                                       Text="Proposés dans la liste VÉHICULE, en plus du véhicule du fichier. Double-cliquez une cellule pour la modifier." />
                            <Border BorderBrush="#E3E8EC" BorderThickness="1" CornerRadius="10" Padding="1">
                                <DataGrid Style="{StaticResource EditableGrid}" ItemsSource="{Binding Vehicles}" SelectedItem="{Binding SelectedVehicle}">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="" Width="40" IsReadOnly="True" CanUserResize="False">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Ellipse Width="10" Height="10" Fill="{Binding IsValid, Converter={StaticResource StatusBrush}}" ToolTip="{Binding Error}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Nom" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MinWidth="200" FontWeight="SemiBold" />
                                        <DataGridTextColumn Header="Longueur utile (mm)" Binding="{Binding Length}" />
                                        <DataGridTextColumn Header="Largeur utile (mm)" Binding="{Binding Width}" />
                                        <DataGridTextColumn Header="Hauteur utile (mm)" Binding="{Binding Height}" />
                                        <DataGridTextColumn Header="Charge utile (kg)" Binding="{Binding Payload}" />
                                        <DataGridTextColumn Header="Largeur porte (mm)" Binding="{Binding DoorWidth, TargetNullValue=''}" />
                                        <DataGridTextColumn Header="Hauteur porte (mm)" Binding="{Binding DoorHeight, TargetNullValue=''}" />
                                        <DataGridTextColumn Header="Résumé" Binding="{Binding Summary}" IsReadOnly="True" Foreground="{StaticResource MutedBrush}" />
                                        <DataGridTextColumn Header="Contrôle" Binding="{Binding Error}" IsReadOnly="True" Foreground="{StaticResource DangerBrush}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </DockPanel>
                    </DockPanel>
                </Border>
            </Border>

            <!-- Calcul en cours -->
            <Border Grid.Row="3" Background="#80EAEDED" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource CardStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24,16">
                    <StackPanel>
                        <TextBlock Text="Calcul des solutions en cours…" FontSize="15" FontWeight="SemiBold" />
                        <ProgressBar IsIndeterminate="True" Height="6" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </Border>
        </Grid>

        <!-- ===================== Panneau droit ===================== -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Margin="0,4,6,4"
                      Visibility="{Binding HasFile, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <Border Style="{StaticResource CardStyle}" Margin="6">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" FontSize="14">
                            <Run Text="{Binding CurrentLoad.Label, Mode=OneWay}" /><Run Text=" · occupation" />
                        </TextBlock>

                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" FontWeight="SemiBold" Text="{Binding LoadMetrics.WeightRate, StringFormat={}{0:0} %}" />
                            <TextBlock Text="Poids" />
                        </DockPanel>
                        <ProgressBar Style="{StaticResource KpiBar}" Value="{Binding LoadMetrics.WeightRate, Mode=OneWay}"
                                     Foreground="{Binding LoadMetrics.WeightRate, Converter={StaticResource RateBrush}}" Margin="0,3,0,2" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,10">
                            <Run Text="{Binding LoadMetrics.LoadedWeightKg, StringFormat={}{0:N0} kg, Mode=OneWay}" />
                            <Run Text="/" />
                            <Run Text="{Binding LoadMetrics.VehiclePayloadKg, StringFormat={}{0:N0} kg, Mode=OneWay}" />
                        </TextBlock>

                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" FontWeight="SemiBold" Text="{Binding LoadMetrics.LinearRealRate, StringFormat={}{0:0} %}" />
                            <TextBlock Text="Métrage linéaire réel" />
                        </DockPanel>
                        <ProgressBar Style="{StaticResource KpiBar}" Value="{Binding LoadMetrics.LinearRealRate, Mode=OneWay}"
                                     Foreground="{Binding LoadMetrics.LinearRealRate, Converter={StaticResource RateBrush}}" Margin="0,3,0,2" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,10">
                            <Run Text="{Binding LoadMetrics.LinearMetersReal, StringFormat={}{0:N2} m, Mode=OneWay}" />
                            <Run Text="/" />
                            <Run Text="{Binding LoadMetrics.VehicleLinearMeters, StringFormat={}{0:N2} m, Mode=OneWay}" />
                            <Run Text=" · équivalent " />
                            <Run Text="{Binding LoadMetrics.LinearMetersEquivalent, StringFormat={}{0:N2} m, Mode=OneWay}" />
                        </TextBlock>

                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" FontWeight="SemiBold" Text="{Binding LoadMetrics.FloorRate, StringFormat={}{0:0} %}" />
                            <TextBlock Text="Surface au sol" />
                        </DockPanel>
                        <ProgressBar Style="{StaticResource KpiBar}" Value="{Binding LoadMetrics.FloorRate, Mode=OneWay}"
                                     Foreground="{Binding LoadMetrics.FloorRate, Converter={StaticResource RateBrush}}" Margin="0,3,0,2" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,10">
                            <Run Text="{Binding LoadMetrics.FloorUsedM2, StringFormat={}{0:N2} m², Mode=OneWay}" />
                            <Run Text="/" />
                            <Run Text="{Binding LoadMetrics.VehicleFloorM2, StringFormat={}{0:N2} m², Mode=OneWay}" />
                        </TextBlock>

                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" FontWeight="SemiBold" Text="{Binding LoadMetrics.VolumeRate, StringFormat={}{0:0} %}" />
                            <TextBlock Text="Volume" />
                        </DockPanel>
                        <ProgressBar Style="{StaticResource KpiBar}" Value="{Binding LoadMetrics.VolumeRate, Mode=OneWay}"
                                     Foreground="{Binding LoadMetrics.VolumeRate, Converter={StaticResource RateBrush}}" Margin="0,3,0,2" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,10">
                            <Run Text="{Binding LoadMetrics.LoadedVolumeM3, StringFormat={}{0:N2} m³, Mode=OneWay}" />
                            <Run Text="/" />
                            <Run Text="{Binding LoadMetrics.VehicleVolumeM3, StringFormat={}{0:N2} m³, Mode=OneWay}" />
                        </TextBlock>

                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Unités / articles" />
                            <TextBlock Grid.Column="1" FontWeight="SemiBold">
                                <Run Text="{Binding LoadMetrics.UnitsPlaced, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding LoadMetrics.ItemsPlaced, StringFormat=N0, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Grid.Row="1" Text="Hauteur max chargée" />
                            <TextBlock Grid.Row="1" Grid.Column="1" FontWeight="SemiBold" Text="{Binding LoadMetrics.MaxLoadHeight, StringFormat={}{0:N0} mm}" />
                            <TextBlock Grid.Row="2" Text="Centre de gravité X / Y / Z" />
                            <TextBlock Grid.Row="2" Grid.Column="1" FontWeight="SemiBold">
                                <Run Text="{Binding LoadMetrics.CgX, StringFormat=N0, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding LoadMetrics.CgY, StringFormat=N0, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding LoadMetrics.CgZ, StringFormat=N0, Mode=OneWay}" />
                            </TextBlock>
                        </Grid>
                        <TextBlock Text="Ce qui limite ce camion" Margin="0,8,0,0" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding LoadMetrics.LimitingFactor}" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Foreground="{StaticResource WarningBrush}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="6">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Style="{StaticResource LightButton}" Margin="0" Padding="8,2"
                                    Content="Tout afficher" Command="{Binding ClearHighlightCommand}" FontSize="11.5" />
                            <TextBlock Style="{StaticResource CardTitle}" Text="Affichage" FontSize="14" Margin="0" VerticalAlignment="Center" />
                        </DockPanel>
                        <ComboBox ItemsSource="{Binding ColorModes}" SelectedItem="{Binding SelectedColorMode}" Padding="8,4" Margin="0,0,0,6" />
                        <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                                 ToolTip="Rechercher un ordre, un article, un client, une commande : les autres unités sont estompées" />
                        <TextBlock Style="{StaticResource Muted}" Text="Cliquez une couleur pour la mettre en évidence :" Margin="0,0,0,4" />
                        <ItemsControl ItemsSource="{Binding Legend}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource LegendButton}" ToolTip="Cliquer pour mettre en évidence"
                                            Command="{Binding DataContext.ToggleLegendCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="{Binding Brush}" Width="14" Height="14" CornerRadius="3" Margin="0,0,8,0" />
                                            <TextBlock x:Name="Lbl" Text="{Binding Label}" TextTrimming="CharacterEllipsis" MaxWidth="240" />
                                        </StackPanel>
                                    </Button>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter TargetName="Lbl" Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="6">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Unité sélectionnée" FontSize="14" />
                        <TextBlock Text="{Binding SelectedUnitText}" TextWrapping="Wrap" LineHeight="19" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <!-- Dépôt de fichier -->
        <Border x:Name="DropOverlay" Grid.ColumnSpan="3" Background="#CC34495E" Visibility="Collapsed" IsHitTestVisible="False">
            <Border BorderBrush="White" BorderThickness="3" CornerRadius="18" Margin="40" Background="#225DADE2">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE896;" FontSize="54" Foreground="White" HorizontalAlignment="Center" />
                    <TextBlock Text="Déposez le fichier pour l'importer" Foreground="White" FontSize="24" FontWeight="SemiBold" Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </Border>

        <!-- Notification -->
        <Border Grid.ColumnSpan="3" Style="{StaticResource Toast}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding CloseToastCommand}" Foreground="#BDC3C7"
                        Margin="10,0,0,0" Padding="4,2">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE711;" FontSize="10" />
                </Button>
                <Ellipse DockPanel.Dock="Left" Width="12" Height="12" Margin="0,0,10,0" VerticalAlignment="Center"
                         Fill="{Binding ToastKind, Converter={StaticResource StatusBrush}}" />
                <TextBlock Text="{Binding ToastText}" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="13" />
            </DockPanel>
        </Border>

        <!-- Nouveautés de la version -->
        <Border Grid.ColumnSpan="3" Background="#9922313F" Visibility="{Binding IsReleaseNotesOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource CardStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="620" Padding="28,24" MaxHeight="760">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                        <Image DockPanel.Dock="Left" Source="{StaticResource LogoImage}" Width="56" Height="56" Margin="0,0,14,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="21" FontWeight="Bold" Foreground="{StaticResource TextBrush}">
                                <Run Text="Nouveautés d'OptiTunes " /><Run Text="{Binding AppVersion, Mode=OneWay}" Foreground="{StaticResource PrimaryBrush}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Muted}" FontSize="12" Text="Ce qui a changé dans les dernières versions." />
                        </StackPanel>
                    </DockPanel>
                    <Button DockPanel.Dock="Bottom" Style="{StaticResource RoundedButton}" Command="{Binding CloseReleaseNotesCommand}"
                            HorizontalAlignment="Right" Padding="22,9" Margin="0,16,0,0" Content="C'est parti" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ReleaseNotesList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F7F9FA" CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <Border Background="{StaticResource PanelDarkBrush}" CornerRadius="8" Padding="8,2" Margin="0,0,10,0">
                                                    <TextBlock Foreground="White" FontWeight="SemiBold" FontSize="11.5"><Run Text="v" /><Run Text="{Binding Version, Mode=OneWay}" /></TextBlock>
                                                </Border>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel Margin="0,3">
                                                            <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" Text="&#xE73E;" FontSize="11"
                                                                       Foreground="{StaticResource SuccessBrush}" Margin="2,3,10,0" />
                                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Border>

        <!-- Aide : description des colonnes du fichier -->
        <Border Grid.ColumnSpan="3" Background="#9922313F" Visibility="{Binding IsFormatHelpOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource CardStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="1000" Padding="28,22" MaxHeight="820">
                <Border.Resources>
                    <DataTemplate x:Key="FieldDocTemplate">
                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="4,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="118" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="160" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Column}" FontFamily="Consolas" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,8,0" />
                                </StackPanel>
                                <Border x:Name="Badge" Grid.Column="1" CornerRadius="9" Padding="9,2" HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Background="#EEF1F3">
                                    <TextBlock x:Name="BadgeText" Text="{Binding RequirementLabel}" FontSize="11.5" FontWeight="SemiBold" Foreground="#5D6D7E" />
                                </Border>
                                <TextBlock Grid.Column="2" Text="{Binding Description}" TextWrapping="Wrap" Margin="8,0,12,0" FontSize="12.5" />
                                <StackPanel Grid.Column="3">
                                    <TextBlock Style="{StaticResource Muted}" FontSize="10.5" Text="Exemple" />
                                    <TextBlock FontFamily="Consolas" FontSize="12" TextWrapping="Wrap">
                                        <Run Text="{Binding Example1, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Example2, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Requirement}" Value="Obligatoire">
                                <Setter TargetName="Badge" Property="Background" Value="#FDEDEC" />
                                <Setter TargetName="BadgeText" Property="Foreground" Value="#C0392B" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Requirement}" Value="Conditionnelle">
                                <Setter TargetName="Badge" Property="Background" Value="#FEF5E7" />
                                <Setter TargetName="BadgeText" Property="Foreground" Value="#B9770E" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Requirement}" Value="Recommandee">
                                <Setter TargetName="Badge" Property="Background" Value="#EBF5FB" />
                                <Setter TargetName="BadgeText" Property="Foreground" Value="#2471A3" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </Border.Resources>
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding CloseFormatHelpCommand}"
                                VerticalAlignment="Top" Padding="8,4" ToolTip="Fermer (Échap)">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE711;" FontSize="12" />
                        </Button>
                        <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="22" Background="{StaticResource PrimaryBrush}" Margin="0,0,14,0">
                            <TextBlock Text="i" Foreground="White" FontSize="24" FontWeight="Bold" FontFamily="Georgia"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Format du fichier d'import" FontSize="21" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                                       Text="Fichier .csv / .txt, séparateur « ; ». Une ligne GRP par groupage, puis une ligne OT par ordre. Dimensions en mm, poids en kg. Les en-têtes #GRP; / #OT; sont facultatifs et permettent de mettre les colonnes dans n'importe quel ordre." />
                        </StackPanel>
                    </DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="58,0,0,12">
                        <Border Background="#FDEDEC" CornerRadius="9" Padding="9,2" Margin="0,0,6,4">
                            <TextBlock Foreground="#C0392B" FontSize="11.5" FontWeight="SemiBold" Text="Obligatoire : sans elle, la ligne est bloquée" />
                        </Border>
                        <Border Background="#FEF5E7" CornerRadius="9" Padding="9,2" Margin="0,0,6,4">
                            <TextBlock Foreground="#B9770E" FontSize="11.5" FontWeight="SemiBold" Text="Selon le cas : dépend du type physique" />
                        </Border>
                        <Border Background="#EBF5FB" CornerRadius="9" Padding="9,2" Margin="0,0,6,4">
                            <TextBlock Foreground="#2471A3" FontSize="11.5" FontWeight="SemiBold" Text="Recommandée : calcul possible, avec avertissement" />
                        </Border>
                        <Border Background="#EEF1F3" CornerRadius="9" Padding="9,2" Margin="0,0,6,4">
                            <TextBlock Foreground="#5D6D7E" FontSize="11.5" FontWeight="SemiBold" Text="Facultative" />
                        </Border>
                    </WrapPanel>
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0" LastChildFill="False">
                        <Button DockPanel.Dock="Right" Style="{StaticResource RoundedButton}" Command="{Binding CloseFormatHelpCommand}" Padding="22,9" Content="Fermer" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource OutlineButton}" Command="{Binding ExportTemplateCommand}" Padding="16,9" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE9F9;" Margin="0,2,8,0" />
                                <TextBlock Text="Exporter le modèle CSV" />
                            </StackPanel>
                        </Button>
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Muted}" FontSize="11.5" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="560"
                                   Text="Les noms ERP sont aussi reconnus (IC_CHAR3_1 = MAGASIN, IC_NUM1 = DEPART, IC_NUM2 = ARRIVEE…), ainsi qu'un tableau à une ligne par ordre." />
                    </DockPanel>
                    <TabControl>
                        <TabItem Header="Groupage (ligne GRP)">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,6,8,0">
                                <ItemsControl ItemsSource="{Binding GroupageFieldDocs}" ItemTemplate="{StaticResource FieldDocTemplate}" />
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Ordre de transport (ligne OT)">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,6,8,0">
                                <ItemsControl ItemsSource="{Binding OrderFieldDocs}" ItemTemplate="{StaticResource FieldDocTemplate}" />
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Border>
        </Border>

    </Grid>
</Window>
